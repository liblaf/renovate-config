// -*- mode: jsonc; -*-
// ref: <https://docs.renovatebot.com/config-overview/#how-its-found>
{
  "$schema": "https://docs.renovatebot.com/renovate-inherited-schema.json",
  "extends": [
    "config:best-practices",
    // By default, Renovate will not assign reviewers and assignees to an
    // automerge-enabled PR unless it fails status checks.
    ":assignAndReview(liblaf)",
    ":automergeAll"
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com",
    "66853113+pre-commit-ci[bot]@users.noreply.github.com",
    "114827586+autofix-ci[bot]@users.noreply.github.com",
    "184555210+liblaf[bot]@users.noreply.github.com",
    "239320757+liblaf-mega-linter[bot]@users.noreply.github.com"
  ],
  "ignoreDeps": ["python", "pytorch", "pytorch3d"],
  "packageRules": [
    {
      "matchCategories": ["ci"],
      "semanticCommitType": "ci"
    },
    {
      "enabled": false,
      "matchFileNames": [
        // copier templates
        ".github/workflows/python-*.yaml",
        ".github/workflows/release-*.yaml",
        ".github/workflows/shared-*.yaml",
        ".github/workflows/typescript-*.yaml"
      ]
    }
  ],
  "platformAutomerge": false
}
